---
import Layout from "../layouts/Layout.astro";
import ButtonOldCopy from "../components/ButtonOldCopy.astro";
import { API_BASE_URL } from "../config";
---

<Layout title="Cuenta">
  <!-- ======= HEADER / PERFIL ======= -->
  <section id="account-info" class="kp-card">
    <p>Cargando datos del usuario...</p>
  </section>

  <!-- ======= MEMBRESÍAS ======= -->
  <section id="memberships-container" class="kp-card kp-memberships">
    <h2 class="kp-section-title">Membresías</h2>
    <!-- Cards se inyectan por JS -->
  </section>

  <!-- ======= ACCIONES ======= -->
  <div class="button-container">
    <ButtonOldCopy
      href="login"
      title="Salir"
      body=""
      imageSrc=""
      color="#e65046"
      width="280px"
      height="56px"
    />
  </div>

  <!-- base URL para fetch -->
  <div id="cfg" data-api-base-url={API_BASE_URL}></div>

  <script>
    document.addEventListener("DOMContentLoaded", async () => {
      const idUsuario = sessionStorage.getItem("id");
      const nombreUsuario = sessionStorage.getItem("nombre") || "";
      const apellidoUsuario = sessionStorage.getItem("apellido") || "";
      const mailUsuario = sessionStorage.getItem("email") || "";
      const dniUsuario = sessionStorage.getItem("dni") || "";
      const pacientesActivos = localStorage.getItem("pacientes_activos") || "0";

      const accountInfoDiv = document.getElementById("account-info");

      async function fetchAccountMembership() {
        try {
          const API_BASE_URL =
            document.getElementById("cfg").dataset.apiBaseUrl;
          const res = await fetch(
            `${API_BASE_URL}/membresias.php?id_usuario=${idUsuario}`
          );
          if (!res.ok) throw new Error("Error al obtener las membresías");
          return await res.json();
        } catch (e) {
          console.error(e);
          return null;
        }
      }

      if (!idUsuario) {
        accountInfoDiv.innerHTML = `<p class="kp-muted">No has iniciado sesión.</p>`;
        return;
      }

      const membership = await fetchAccountMembership();

      accountInfoDiv.innerHTML = `
        <div class="kp-account-head">
          <h1 class="kp-title">Mi cuenta</h1>
          <div class="kp-divider"></div>
        </div>

        <div class="kp-grid">
          <p><strong>Nombre:</strong> <span class="kp-chip">${nombreUsuario} ${apellidoUsuario}</span></p>
          <p><strong>Email:</strong>  <span class="kp-chip">${mailUsuario}</span></p>
          <p><strong>DNI:</strong>    <span class="kp-chip">${dniUsuario}</span></p>
          ${
            membership
              ? `
                <p><strong>Membresía:</strong> <span class="kp-badge">${membership.titulo}</span></p>
                <p><strong>Pacientes Activos:</strong> <span class="kp-chip">${pacientesActivos}/${membership.sesiones_maximas}</span></p>
              `
              : `<p class="kp-muted">No tienes membresías activas.</p>`
          }
        </div>
      `;
    });

    const membershipsContainer = document.getElementById(
      "memberships-container"
    );

    function createMembershipCard(m) {
      const card = document.createElement("article");
      card.className = "membership-card";

      card.innerHTML = `
        <header class="m-head">
          <h3 class="m-title">${m.titulo}</h3>
          <span class="m-badge">Máx. ${m.sesiones_maximas}</span>
        </header>
        <p class="m-desc">${m.observacion || "—"}</p>
      `;
      return card;
    }

    async function loadMemberships() {
      try {
        const API_BASE_URL = document.getElementById("cfg").dataset.apiBaseUrl;
        const list = await fetch(`${API_BASE_URL}/membresias.php`)
          .then((r) => r.json())
          .catch(() => []);
        const frag = document.createDocumentFragment();
        list.forEach((m) => frag.appendChild(createMembershipCard(m)));
        membershipsContainer.appendChild(frag);
      } catch (e) {
        console.error("Error al cargar las membresías:", e);
      }
    }
    loadMemberships();
  </script>

  <style is:global>
    /* ======= Tokens ======= */
    :root {
      --kp-blue: #03a1cf;
      --kp-gold: #ffbd59;
      --kp-blue-10: rgba(3, 161, 207, 0.1);
      --kp-blue-06: rgba(3, 161, 207, 0.06);
      --kp-ink: #0f172a;
      --kp-ink-2: #0b5f7a;
      --kp-muted: #64748b;
    }

    /* ======= Contenedores base ======= */
    .kp-card {
      max-width: 980px;
      margin: 18px auto;
      padding: 16px 18px;
      border-radius: 16px;
      background: #fff;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
      border: 1px solid rgba(3, 161, 207, 0.18);
    }

    /* ======= Encabezado Cuenta ======= */
    .kp-title {
      margin: 2px 0 4px;
      font-weight: 800;
      font-size: clamp(22px, 3.2vw, 34px);
      color: var(--kp-ink);
      letter-spacing: 0.2px;
    }
    .kp-divider {
      width: 140px;
      height: 6px;
      border-radius: 6px;
      background: linear-gradient(90deg, var(--kp-blue), var(--kp-gold));
      opacity: 0.55;
      margin: 6px 0 10px;
    }

    .kp-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 10px 18px;
    }
    .kp-grid p {
      margin: 0;
    }
    .kp-grid strong {
      color: var(--kp-ink-2);
      font-weight: 800;
    }

    /* Chips / Badges */
    .kp-chip {
      display: inline-block;
      padding: 4px 10px;
      margin-left: 6px;
      border-radius: 10px;
      background: rgba(3, 161, 207, 0.08);
      border: 1px solid rgba(3, 161, 207, 0.2);
      color: var(--kp-ink);
      font-weight: 700;
    }
    .kp-badge {
      display: inline-block;
      padding: 4px 10px;
      margin-left: 6px;
      border-radius: 999px;
      background: rgba(255, 189, 89, 0.15);
      border: 1px solid rgba(255, 189, 89, 0.35);
      color: #8a5a00;
      font-weight: 800;
    }
    .kp-muted {
      color: var(--kp-muted);
    }

    /* ======= Sección Membresías ======= */
    .kp-memberships {
      padding-top: 10px;
    }
    .kp-section-title {
      margin: 0 0 12px;
      font-weight: 800;
      color: var(--kp-ink);
      font-size: clamp(18px, 2.2vw, 22px);
      position: relative;
      padding-left: 12px;
    }
    .kp-section-title::before {
      content: "";
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 6px;
      height: 70%;
      border-radius: 6px;
      background: linear-gradient(var(--kp-blue), var(--kp-gold));
      opacity: 0.9;
    }

    /* Grid interno (se arma solo cuando existan varias) */
    #memberships-container {
      display: block;
    }
    #memberships-container .membership-card {
      position: relative;
      border: 2px dashed rgba(255, 189, 89, 0.55);
      border-radius: 14px;
      padding: 12px 14px;
      background:
        radial-gradient(
          150px 150px at 20% 0%,
          var(--kp-blue-06),
          transparent 60%
        ),
        radial-gradient(
          150px 150px at 100% 30%,
          rgba(255, 189, 89, 0.1),
          transparent 60%
        ),
        #fff;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
      transition:
        transform 0.18s ease,
        box-shadow 0.18s ease,
        border-color 0.18s ease;
      margin: 10px 0;
    }
    .membership-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 28px rgba(3, 161, 207, 0.1);
      border-color: rgba(255, 189, 89, 0.75);
    }

    .m-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }
    .m-title {
      margin: 0;
      font-weight: 800;
      color: var(--kp-ink);
      font-size: 18px;
      letter-spacing: 0.2px;
    }
    .m-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(3, 161, 207, 0.1);
      border: 1px solid rgba(3, 161, 207, 0.28);
      color: var(--kp-ink-2);
      font-weight: 800;
      white-space: nowrap;
    }
    .m-desc {
      margin: 6px 0 0;
      color: #0f172a;
    }

    /* ======= Botonera ======= */
    .button-container {
      display: flex;
      justify-content: center;
      margin: 16px auto 26px;
      max-width: 980px;
    }

    /* Responsivo */
    @media (max-width: 640px) {
      .kp-card {
        margin: 12px 10px;
        padding: 14px;
      }
      .kp-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
