---
import Button from "../components/Button.astro";
import LoginLayout from "../layouts/LoginLayout.astro";
import Layout from "../layouts/Layout.astro";
import ButtonOldCopy from "../components/ButtonOldCopy.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<Layout title="loginLayout">
  <body>
    <div class="login-container">
      <h2>Perfíl de Paciente</h2>
      <form id="registerForm" onsubmit="handleRegister(event)">
        <div class="input-group">
          <div class="input-group">
            <label for="nombre">Nombre</label>
            <input type="text" id="nombre" name="nombre" value="" required />
          </div>
          <div class="input-group">
            <label for="apellido">Apellido</label>
            <input
              type="text"
              id="apellido"
              name="apellido"
              value=""
              required
            />
          </div>
          <div class="input-group">
            <label for="dni">DNI</label>
            <input
              type="number"
              id="dni"
              name="dni"
              value=""
              required
              disabled
            />
          </div>

          <div class="input-group">
            <label for="clave">Nueva Contraseña</label>
            <input type="password" id="clave" name="password" value="" />
          </div>
          <div class="checkbox-group">
            <label style="padding-inline: 20px;"
              >Space Evation
              <input
                type="checkbox"
                id="spaceEvation"
                name="spaceEvation"
                value="1"
              />
            </label>

            <label
              >Platform Jump
              <input
                type="checkbox"
                id="platformJump"
                name="platformJump"
                value="2"
              />
            </label>
          </div>
          <div class="button-container">
            <Button title="Actualizar" body="" imageSrc="" color="#FFBD59" />
            <ButtonOldCopy
              href="pacients"
              title="Volver"
              body=""
              imageSrc=""
              color="#03A1CF"
            />
          </div>
        </div>
      </form>

      <script client:load>
        // Valores dinámicos predefinidos para los campos
        const initialValues = {
          nombre: localStorage.getItem("nombre_paciente"),
          apellido: localStorage.getItem("apellido_paciente"),
          dni: localStorage.getItem("dni_paciente"),
        };

        // Aplicar los valores iniciales al cargar la página
        window.addEventListener("DOMContentLoaded", () => {
          // Supongamos que las asignaciones están en localStorage como un array JSON
          const asignaciones =
            JSON.parse(localStorage.getItem("asignaciones_paciente")) || [];

          // Verifica si el ID de la asignación está en el array y marca el checkbox correspondiente
          if (asignaciones.length == 2) {
            document.getElementById("spaceEvation").checked = true;
            document.getElementById("platformJump").checked = true;
          } else if (asignaciones[0].id_aplicacion == 1) {
            document.getElementById("spaceEvation").checked = true;
          } else {
            document.getElementById("platformJump").checked = true;
          }

          Object.keys(initialValues).forEach((id) => {
            const input = document.getElementById(id);
            if (input) input.value = initialValues[id];
          });
        });

        async function handleRegister(event) {
          event.preventDefault(); // Evitar que se recargue la página

          // Obtener los valores del formulario
          const nombre = document.getElementById("nombre").value;
          const apellido = document.getElementById("apellido").value;
          const dni = document.getElementById("dni").value;
          const clave = document.getElementById("clave").value;

          // Verificar si los checkboxes están marcados
          const aplicaciones = [];
          const spaceEvation = document.getElementById("spaceEvation");
          const platformJump = document.getElementById("platformJump");

          if (!spaceEvation.checked && !platformJump.checked) {
            alert(
              "Debes seleccionar al menos una opción (Space Evation o Platform Jump)."
            );
            return;
          }

          // Agregar los valores seleccionados al array
          if (spaceEvation.checked) aplicaciones.push(spaceEvation.value);
          if (platformJump.checked) aplicaciones.push(platformJump.value);

          const id_usuario = sessionStorage.getItem("id");

          // Crear objeto con los datos del paciente
          const pacientData = {
            nombre: nombre,
            apellido: apellido,
            dni: dni,
            id_usuario: id_usuario,
            id_aplicaciones: aplicaciones, // Aquí se asignan las aplicaciones seleccionadas
          };

          if (clave.trim() !== "") {
            pacientData.clave = clave;
          }

          try {
            // Enviar la solicitud POST al backend
            const response = await fetch(
              "http://localhost/usuarios/pacientes.php?update=true",
              {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                },
                body: JSON.stringify(pacientData),
              }
            );

            // Manejar la respuesta
            if (response.ok) {
              alert("Paciente Editado exitosamente.");
              window.location.href = "/pacients"; // Redirigir a la página de pacientes
            } else {
              const errorData = await response.json();
              alert(errorData.error || "Error al crear el paciente.");
            }
          } catch (error) {
            console.error("Error en la solicitud:", error);
            alert("Hubo un problema con la solicitud. Intente de nuevo.");
          }
        }
      </script>
    </div>
  </body>

  <style is:global>
    :root {
      --accent: 136, 58, 234;
      --accent-light: 224, 204, 250;
      --accent-dark: 49, 10, 101;
      --accent-gradient: linear-gradient(
        45deg,
        rgb(var(--accent)),
        rgb(var(--accent-light)) 30%,
        white 60%
      );
    }
    html {
      font-family: system-ui, sans-serif;
      background: #fafafa;
      color: #121212;
      margin: 0;
      padding: 0;
    }

    h1 {
      font-size: 4rem;
      font-weight: 700;
      line-height: 1;
      text-align: center;
      padding-bottom: 20px;
    }
    .login-container {
      width: 25%;
      margin: 5px auto;
      background-color: white;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
      text-align: center;
    }
    h2 {
      margin-bottom: 20px;
      color: rgb(var(--accent-dark));
      font-size: 2rem;
      font-weight: 700;
      line-height: 1;
      text-align: center;
      color: black;
    }
    .input-group,
    .checkbox-group {
      margin-bottom: 15px;
      text-align: left;
      align-items: center;
      justify-content: center;
    }

    .checkbox-group {
      display: flex;
      justify-content: flex-end;
      flex-direction: row-reverse;
    }

    .input-group label,
    .checkbox-group label {
      display: block;
      margin-bottom: 5px;
      color: black;
      font-weight: 600;
    }
    .input-group input,
    .checkbox-group input {
      width: 90%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 5px;
      font-size: 1rem;
    }

    .checkbox-group label {
      display: flex;
    }

    .text-kine {
      color: #ffbd59;
    }
    .text-play {
      color: #03a1cf;
    }

    .button-container {
      display: flex;
      flex-direction: column; /* Alinea los botones uno encima del otro */
      align-items: center; /* Centra los botones horizontalmente */
      gap: 10px; /* Espacio entre los botones */
    }

    button {
      width: 80%; /* O ajusta según lo necesario para que tengan un buen tamaño */
      padding: 10px 20px;
    }
    input[type="checkbox"] {
      /*appearance: none; /* Oculta el diseño predeterminado */
      width: 20px;
      height: 20px;
      border: 2px solid #03a1cf; /* Borde con color */
      border-radius: 4px; /* Bordes redondeados */
      background-color: white; /* Fondo blanco */
      cursor: pointer;
      transition: all 0.3s ease;
    }

    input[type="checkbox"]:checked {
      background-color: #ffbd59; /* Fondo amarillo al estar seleccionado */
      border-color: #ffbd59;
      position: relative;
    }

    input[type="checkbox"]:checked::after {
      content: "✓"; /* Marca de check */
      display: block;
      color: white;
      font-size: 16px;
      text-align: center;
      line-height: 20px;
    }

    /* Efecto hover */
    input[type="checkbox"]:hover {
      border-color: #1363df;
    }
  </style>
</Layout>
