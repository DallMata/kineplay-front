---
import Layout from "../layouts/Layout.astro";
import { API_BASE_URL } from "../config";
---

<Layout title="spaceEvationPlays">
  <div class="container">
    <h4 id="account-info"></h4>

    <!-- Caja de información -->
    <div id="infoBox" class="info-box">
      <p>
        <strong>Tiempo Jugado Total:</strong>
        <span id="tiempoJugadoTotal">00:00:00</span>
      </p>
      <p>
        <strong>Cantidad de Jugadas:</strong>
        <span id="cantidadJuegos">0</span>
      </p>
      <p>
        <strong>Amplitud Media Promedio:</strong>
        <span id="amplitudPromedioTotal">0</span>
      </p>
      <p>
        <strong>Amplitud Máxima Promedio:</strong>
        <span id="amplitudMaximaPromedio">0</span>
      </p>
    </div>

    <!-- Gráficos globales -->
    <canvas id="amplitudMediaChart" width="100%" height="20"></canvas>
    <canvas id="amplitudMaximaChart" width="100%" height="20"></canvas>

    <div id="graficosContainer"></div>

    <!-- base URL para fetch -->
    <div id="cfg" data-api-base-url={API_BASE_URL}></div>

    <!-- Chart.js (CDN) -->
    <script
      src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"
    ></script>

    <!-- Header (médico/paciente/observación) SIN TEMPLATE LITERALS -->
    <script client:load>
      document.addEventListener("DOMContentLoaded", function () {
        var idUsuario = sessionStorage.getItem("id");
        var nombreUsuario = sessionStorage.getItem("nombre") || "";
        var apellidoUsuario = sessionStorage.getItem("apellido") || "";

        var nombrePaciente = localStorage.getItem("nombre_paciente") || "";
        var apellidoPaciente = localStorage.getItem("apellido_paciente") || "";
        var observacion = localStorage.getItem("observacion_tipo") || "";
        if (observacion.indexOf(".") !== -1) {
          observacion = observacion.split(".")[0];
        }

        var accountInfoDiv = document.getElementById("account-info");
        accountInfoDiv.innerHTML = "";

        if (idUsuario) {
          var wrap = document.createElement("div");

          var h1 = document.createElement("h1");
          h1.textContent = observacion ? observacion : "Articulación";
          wrap.appendChild(h1);

          var h2a = document.createElement("h2");
          h2a.textContent = "Médico: " + nombreUsuario + " " + apellidoUsuario;
          wrap.appendChild(h2a);

          var h2p = document.createElement("h2");
          h2p.textContent =
            "Paciente: " + nombrePaciente + " " + apellidoPaciente;
          wrap.appendChild(h2p);

          accountInfoDiv.appendChild(wrap);
        } else {
          var p = document.createElement("p");
          p.textContent = "No has iniciado sesión.";
          accountInfoDiv.appendChild(p);
        }
      });
    </script>

    <!-- Lógica principal SIN TEMPLATE LITERALS -->
    <script type="module">
      (function () {
        var API_BASE_URL = document.getElementById("cfg").dataset.apiBaseUrl;

        function req(path, options) {
          if (!options) options = {};
          var headers = options.headers || {};
          headers["Content-Type"] = "application/json";
          options.headers = headers;

          return fetch(API_BASE_URL + path, options).then(function (res) {
            var ct = res.headers.get("content-type") || "";
            var parse =
              ct.indexOf("application/json") !== -1
                ? res.json().catch(function () {
                    return {};
                  })
                : res.text().then(function (t) {
                    return {
                      error: "Respuesta no JSON (" + res.status + ")",
                      raw: t,
                    };
                  });

            return parse.then(function (data) {
              if (!res.ok) {
                var msg =
                  data && data.error ? data.error : "HTTP " + res.status;
                throw new Error(msg);
              }
              return data;
            });
          });
        }

        function fmtHMS(totalSeconds) {
          var s = Math.max(0, Math.floor(Number(totalSeconds) || 0));
          var hh = String(Math.floor(s / 3600)).padStart(2, "0");
          var mm = String(Math.floor((s % 3600) / 60)).padStart(2, "0");
          var ss = String(s % 60).padStart(2, "0");
          return hh + ":" + mm + ":" + ss;
        }

        function getJuegosByPaciente(idUsuarioPaciente, idAplicacion) {
          var qs = new URLSearchParams({
            id_usuario_paciente: String(idUsuarioPaciente),
            id_aplicacion: String(idAplicacion),
          });
          return req("/juegos.php?" + qs.toString());
        }

        function getDatosJuego(id_juego, id_tipo) {
          return req(
            "/juego_datos.php?id_juego=" +
              encodeURIComponent(id_juego) +
              "&id_tipo=" +
              encodeURIComponent(id_tipo)
          ).catch(function (e) {
            var msg = String((e && e.message) || "");
            if (
              msg.indexOf("404") !== -1 ||
              msg.indexOf("Sin datos") !== -1 ||
              msg.indexOf("No hay") !== -1
            ) {
              return [];
            }
            console.warn("getDatosJuego fallo:", e);
            return [];
          });
        }

        // Config de filtros
        var KP_FILTERS = {
          hideNoData: true,
          hideAllZero: true,
          eps: 0.5,
          minPoints: 10,
        };

        function shouldKeepSession(puntos, calc, filters) {
          var hideNoData = !!filters.hideNoData;
          var hideAllZero = !!filters.hideAllZero;
          var eps = Number(filters.eps) || 0;
          var minPoints = Number(filters.minPoints) || 0;

          if (hideNoData && (!puntos || puntos.length === 0)) return false;
          if (
            minPoints > 0 &&
            puntos &&
            puntos.length > 0 &&
            puntos.length < minPoints
          )
            return false;

          if (hideAllZero) {
            if (puntos && puntos.length > 0) {
              var hasSignal = false;
              for (var i = 0; i < puntos.length; i++) {
                var a = Math.abs(Number(puntos[i].angulo) || 0);
                if (a >= eps) {
                  hasSignal = true;
                  break;
                }
              }
              if (!hasSignal) return false;
            } else {
              var m = Math.abs(Number((calc && calc.max) || 0));
              var me = Math.abs(Number((calc && calc.media) || 0));
              if (m < eps && me < eps) return false;
            }
          }
          return true;
        }

        function calcAmplitudesDesdePuntos(puntos) {
          if (!puntos || !puntos.length) return { media: 0, max: 0 };
          var sum = 0,
            maxv = 0,
            n = 0;
          for (var i = 0; i < puntos.length; i++) {
            var v = Math.abs(Number(puntos[i].angulo) || 0);
            if (isFinite(v)) {
              sum += v;
              if (v > maxv) maxv = v;
              n++;
            }
          }
          return n ? { media: sum / n, max: maxv } : { media: 0, max: 0 };
        }

        function el(tag, text) {
          var e = document.createElement(tag);
          if (text != null) e.textContent = String(text);
          return e;
        }

        function renderJuego(idx, juego, puntos, calc) {
          var cont = el("div");
          cont.className = "juego-container";

          var head = el("div");
          head.className = "juego-head";
          var h2 = el("h2", "Jugada " + (idx + 1));
          h2.className = "kp-jugada-title";
          head.appendChild(h2);

          var meta = el("div");
          meta.className = "kp-jugada-meta";

          function row(label, value) {
            var p = el("p");
            var b = el("strong", label + ":");
            var span = el("span", value);
            span.className = "kp-value";
            p.appendChild(b);
            p.appendChild(document.createTextNode(" "));
            p.appendChild(span);
            return p;
          }

          meta.appendChild(row("Fecha", juego.fecha || "-"));
          meta.appendChild(
            row(
              "Tiempo Jugado",
              Number(juego.tiempo_jugado || 0).toFixed(2) + " s"
            )
          );
          meta.appendChild(row("Puntaje", juego.puntaje || 0));
          meta.appendChild(
            row("Amplitud Máxima", (calc.max || 0).toFixed(2) + "°")
          );
          meta.appendChild(
            row("Amplitud Media", (calc.media || 0).toFixed(2) + "°")
          );

          var canvas = el("canvas");
          canvas.id = "juegoChart" + idx;
          canvas.width = 100;
          canvas.height = 30;

          cont.appendChild(head);
          cont.appendChild(meta);
          cont.appendChild(canvas);

          var wrapper = document.getElementById("graficosContainer");
          if (wrapper) wrapper.appendChild(cont);

          if (puntos && puntos.length) {
            var tiempos = [];
            var angulos = [];
            for (var i = 0; i < puntos.length; i++) {
              tiempos.push(puntos[i].tiempo);
              angulos.push(puntos[i].angulo);
            }
            var ctx = canvas.getContext("2d");
            new window.Chart(ctx, {
              type: "line",
              data: {
                labels: tiempos,
                datasets: [
                  {
                    label: "Ángulo",
                    data: angulos,
                    borderColor: "rgba(60,150,255,0.8)",
                    borderWidth: 2,
                    fill: false,
                  },
                ],
              },
              options: {
                scales: {
                  x: {
                    title: {
                      display: true,
                      text: "Tiempo (ms)",
                      color: "#2c3e50",
                    },
                  },
                  y: {
                    title: {
                      display: true,
                      text: "Ángulo (°)",
                      color: "#2c3e50",
                    },
                  },
                },
                plugins: { legend: { labels: { color: "#2c3e50" } } },
              },
            });
          }
        }

        function buildLineChart(
          canvasId,
          labels,
          dataArr,
          label,
          bg,
          border,
          yTitle
        ) {
          var canvas = document.getElementById(canvasId);
          if (!canvas) return;
          var ctx = canvas.getContext("2d");
          new window.Chart(ctx, {
            type: "line",
            data: {
              labels: labels,
              datasets: [
                {
                  label: label,
                  data: dataArr,
                  backgroundColor: bg,
                  borderColor: border,
                  borderWidth: 3,
                  pointRadius: 4,
                  pointHoverRadius: 6,
                  pointBorderWidth: 2,
                  fill: false,
                  tension: 0.2,
                },
              ],
            },
            options: {
              plugins: {
                legend: {
                  labels: {
                    color: "#2c3e50",
                    font: { size: 14, weight: "600" },
                  },
                },
                tooltip: {
                  titleFont: { size: 14, weight: "700" },
                  bodyFont: { size: 13 },
                },
              },
              scales: {
                x: {
                  title: {
                    display: true,
                    text: "Número de Jugada",
                    color: "#2c3e50",
                    font: { size: 14, weight: "700" },
                  },
                  ticks: {
                    color: "#2c3e50",
                    font: { size: 13, weight: "600" },
                  },
                  grid: { lineWidth: 1 },
                },
                y: {
                  title: {
                    display: true,
                    text: yTitle,
                    color: "#2c3e50",
                    font: { size: 14, weight: "700" },
                  },
                  ticks: {
                    color: "#2c3e50",
                    font: { size: 13, weight: "600" },
                  },
                  grid: { lineWidth: 1 },
                },
              },
            },
          });
        }

        function main() {
          var idUsuarioPaciente = Number(
            localStorage.getItem("id_usuario_paciente") || 0
          );
          var idTipo = Number(localStorage.getItem("id_tipo") || 0);

          if (!idUsuarioPaciente || !idTipo) {
            console.error(
              "Faltan id_usuario_paciente o id_tipo en localStorage"
            );
            var gc = document.getElementById("graficosContainer");
            if (gc)
              gc.innerHTML =
                "<p style='color:#b00020'>No se pudieron cargar las jugadas (falta información del paciente o articulación).</p>";
            var tj = document.getElementById("tiempoJugadoTotal");
            if (tj) tj.textContent = "00:00:00";
            return;
          }

          var idAplicacion = idTipo === 22 ? 1 : 2;

          getJuegosByPaciente(idUsuarioPaciente, idAplicacion)
            .then(function (juegos) {
              if (!Array.isArray(juegos))
                throw new Error("Respuesta inesperada de juegos.php");

              if (juegos.length === 0) {
                var gc = document.getElementById("graficosContainer");
                if (gc)
                  gc.innerHTML =
                    "<p>El paciente no tiene jugadas en esta articulación.</p>";
                document.getElementById("cantidadJuegos").textContent = "0";
                document.getElementById("amplitudPromedioTotal").textContent =
                  "0.00";
                document.getElementById("amplitudMaximaPromedio").textContent =
                  "0.00";
                document.getElementById("tiempoJugadoTotal").textContent =
                  "00:00:00";
                return;
              }

              var labels = [];
              var medias = [];
              var maximas = [];
              var sumaMedia = 0;
              var sumaMax = 0;
              var totalSeg = 0;
              var visibles = [];

              var gc = document.getElementById("graficosContainer");
              if (gc) gc.innerHTML = "";

              // Secuencia: pedir datos por juego en cadena (para mantener orden)
              var chain = Promise.resolve();
              juegos.forEach(function (jg, idx) {
                chain = chain.then(function () {
                  return getDatosJuego(jg.id_juego, idTipo).then(
                    function (puntos) {
                      var calc;
                      var hasBackendAmps =
                        isFinite(Number(jg.amplitud_media)) &&
                        isFinite(Number(jg.amplitud_maxima));
                      if (hasBackendAmps) {
                        calc = {
                          media: Math.abs(Number(jg.amplitud_media)),
                          max: Math.abs(Number(jg.amplitud_maxima)),
                        };
                      } else {
                        calc = calcAmplitudesDesdePuntos(puntos);
                      }

                      if (!shouldKeepSession(puntos, calc, KP_FILTERS)) return;

                      visibles.push({ juego: jg, puntos: puntos, calc: calc });
                      labels.push("Jugada " + visibles.length);
                      medias.push(Number((calc.media || 0).toFixed(2)));
                      maximas.push(Number((calc.max || 0).toFixed(2)));
                      sumaMedia += calc.media || 0;
                      sumaMax += calc.max || 0;
                      totalSeg += Number(jg.tiempo_jugado || 0);
                    }
                  );
                });
              });

              chain
                .then(function () {
                  // Render individuales
                  for (var k = 0; k < visibles.length; k++) {
                    renderJuego(
                      k,
                      visibles[k].juego,
                      visibles[k].puntos,
                      visibles[k].calc
                    );
                  }

                  // KPIs globales
                  document.getElementById("cantidadJuegos").textContent =
                    String(visibles.length);
                  var n = visibles.length || 1;
                  var promMedia = sumaMedia / n;
                  var promMax = sumaMax / n;
                  document.getElementById("amplitudPromedioTotal").textContent =
                    promMedia.toFixed(2) + "°";
                  document.getElementById(
                    "amplitudMaximaPromedio"
                  ).textContent = promMax.toFixed(2) + "°";
                  document.getElementById("tiempoJugadoTotal").textContent =
                    fmtHMS(totalSeg);

                  // Charts globales
                  buildLineChart(
                    "amplitudMediaChart",
                    labels,
                    medias,
                    "Amplitud Media",
                    "rgba(230,160,60,1)",
                    "rgba(255,189,89,1)",
                    "Amplitud Media (°)"
                  );
                  buildLineChart(
                    "amplitudMaximaChart",
                    labels,
                    maximas,
                    "Amplitud Máxima",
                    "rgba(200,60,50,1)",
                    "rgba(230,80,70,1)",
                    "Amplitud Máxima (°)"
                  );
                })
                .catch(function (e) {
                  console.error(e);
                  var gc2 = document.getElementById("graficosContainer");
                  if (gc2)
                    gc2.innerHTML =
                      "<p style='color:#b00020'>No se pudieron procesar las jugadas.</p>";
                  document.getElementById("tiempoJugadoTotal").textContent =
                    "00:00:00";
                });
            })
            .catch(function (e) {
              console.error("Error trayendo juegos:", e);
              var gc = document.getElementById("graficosContainer");
              if (gc)
                gc.innerHTML =
                  "<p style='color:#b00020'>No se pudieron cargar las jugadas.</p>";
              document.getElementById("tiempoJugadoTotal").textContent =
                "00:00:00";
            });
        }

        try {
          main();
        } catch (e) {
          console.error(e);
          var gc = document.getElementById("graficosContainer");
          if (gc)
            gc.innerHTML =
              "<p style='color:#b00020'>No se pudieron cargar las jugadas.</p>";
          document.getElementById("tiempoJugadoTotal").textContent = "00:00:00";
        }
      })();
    </script>
  </div>
</Layout>

<style is:global>
  /* =============================
   TITULARES SUPERIORES (header)
   ============================= */
  #account-info {
    margin: 6px 2px 14px;
  }
  #account-info h1 {
    margin: 0 0 6px;
    font-weight: 800;
    font-size: clamp(22px, 3.2vw, 36px);
    line-height: 1.12;
    color: #0f172a;
    letter-spacing: 0.2px;
    position: relative;
  }
  #account-info h1::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 140px;
    height: 6px;
    border-radius: 6px;
    background: linear-gradient(90deg, #03a1cf, #ffbd59);
    opacity: 0.6;
  }
  #account-info h2 {
    margin: 6px 0 0;
    font-weight: 700;
    font-size: clamp(14px, 1.8vw, 18px);
    color: #0b5f7a;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  #account-info h2::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #03a1cf;
    box-shadow: 12px 0 0 #ffbd59;
  }

  /* =============================
   INFO BOX (arriba)
   ============================= */
  .info-box strong {
    color: #0b5f7a;
  }
  .info-box span {
    display: inline-block;
    padding: 2px 8px;
    margin-left: 6px;
    border-radius: 8px;
    background: rgba(3, 161, 207, 0.08);
    border: 1px solid rgba(3, 161, 207, 0.18);
    color: #0f172a;
    font-weight: 700;
  }

  /* =====================================
   JUGADAS ESPECÍFICAS (cards de jugada)
   ===================================== */
  .juego-container {
    border: 1px dashed rgba(255, 189, 89, 0.6);
    border-radius: 14px;
    padding: 12px;
    margin: 16px 0;
    background: #fff;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.05);
  }

  .kp-jugada-title {
    position: relative;
    margin: 0 0 8px;
    padding-left: 14px;
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: 0.2px;
  }
  .kp-jugada-title::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 70%;
    border-radius: 6px;
    background: linear-gradient(#03a1cf, #ffbd59);
    opacity: 0.9;
  }

  .kp-jugada-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 6px 14px;
  }
  .kp-jugada-meta p {
    margin: 0;
  }
  .kp-jugada-meta strong {
    color: #0b5f7a;
    font-weight: 800;
  }

  .kp-value {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 8px;
    background: rgba(3, 161, 207, 0.08);
    border: 1px solid rgba(3, 161, 207, 0.18);
    color: #0f172a;
    font-weight: 700;
  }

  .juego-container:hover {
    box-shadow: 0 10px 24px rgba(3, 161, 207, 0.08);
    transform: translateY(-1px);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .juego-container {
      transition: none !important;
    }
  }

  .container {
    margin: 5px;
  }
  .info-box {
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 12px;
    background: #fff;
  }
  .juego-container {
    border: 1px dashed #ffbd59;
    border-radius: 12px;
    padding: 10px;
    margin: 16px 0;
    background: #fff;
  }
</style>
