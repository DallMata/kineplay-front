---
import BurgerMenu from "../components/Button.astro";
import Card from "../components/Card.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Si tu Header renderiza HTML visible, movelo al <body>. -->
  </head>
  <body>
    <Header title="header" />
    <div class="container">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --kp-blue: #03a1cf;
    --kp-gold: #ffbd59;
    --kp-blue-10: rgba(3, 161, 207, 0.1);
    --kp-blue-06: rgba(3, 161, 207, 0.06);
    --kp-gold-10: rgba(255, 189, 89, 0.1);
    --kp-gold-06: rgba(255, 189, 89, 0.06);
    --kp-neutral: #f7f9fb;

    /* (si las usás) */
    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      rgb(var(--accent-light)) 30%,
      #fff 60%
    );
  }

  html,
  body {
    min-height: 100%;
    margin: 0;
    padding: 0;
  }
  html {
    font-family: system-ui, sans-serif;
    color: #121212;
  }

  /* FONDO SCROLLEABLE */
  body {
    /* 1) patrón SVG (arriba, muy sutil) + 2-5) gradientes */
    background-image:
      url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="900" height="900" viewBox="0 0 900 900"><defs><g id="joy"><path d="M15 8 h20 a10 10 0 0 1 10 10 v10 a10 10 0 0 1 -10 10 h-20 a10 10 0 0 1 -10 -10 v-10 a10 10 0 0 1 10 -10z" fill="none" stroke="%2303A1CF" stroke-width="2" stroke-opacity=".28"/><circle cx="22" cy="18" r="3" fill="%2303A1CF" fill-opacity=".22"/><circle cx="38" cy="22" r="2" fill="%23FFBD59" fill-opacity=".22"/></g><g id="chip"><rect x="5" y="5" width="30" height="30" rx="4" fill="none" stroke="%2303A1CF" stroke-width="2" stroke-opacity=".24"/><rect x="12" y="12" width="16" height="16" rx="2" fill="none" stroke="%23FFBD59" stroke-width="2" stroke-opacity=".22"/></g><g id="steth"><circle cx="20" cy="18" r="6" fill="none" stroke="%2303A1CF" stroke-width="2" stroke-opacity=".26"/><path d="M26 18 c0 6 4 10 10 10 s10 -4 10 -10" fill="none" stroke="%23FFBD59" stroke-width="2" stroke-opacity=".22"/></g><g id="ecg"><path d="M0 20 L10 20 14 8 18 28 22 16 26 20 40 20" fill="none" stroke="%2303A1CF" stroke-width="2" stroke-opacity=".26"/></g><pattern id="p" width="140" height="140" patternUnits="userSpaceOnUse"><use href="%23joy" x="10" y="10"/><use href="%23chip" x="75" y="8"/><use href="%23steth" x="12" y="75"/><use href="%23ecg" x="60" y="90"/></pattern></defs><rect width="100%" height="100%" fill="url(%23p)"/></svg>'),
      radial-gradient(60vw 60vw at 10% 5%, var(--kp-blue-06), transparent 60%),
      radial-gradient(50vw 50vw at 95% 20%, var(--kp-gold-06), transparent 65%),
      radial-gradient(40vw 40vw at 15% 85%, var(--kp-blue-10), transparent 60%),
      linear-gradient(180deg, #fff, var(--kp-neutral) 40%, #fff 100%);
    background-size:
      900px 900px,
      auto,
      auto,
      auto,
      auto;
    background-repeat: repeat, no-repeat, no-repeat, no-repeat, no-repeat;
    background-attachment:
      scroll, scroll, scroll, scroll, scroll; /* <-- scrollea */
    min-height: 100vh;
  }

  h1 {
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    margin-bottom: 1em;
  }
  code {
    font-family:
      Menlo, Monaco, "Lucida Console", "Liberation Mono", "DejaVu Sans Mono",
      "Bitstream Vera Sans Mono", "Courier New", monospace;
  }
  .container {
  }
</style>
